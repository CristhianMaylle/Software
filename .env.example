# Copia este archivo a .env y completa los valores reales (el .env NO se versiona).
# DB_SERVER es el nombre del servicio de Postgres en docker-compose (db).
DB_SERVER=db
DB_PORT=5432
DB_NAME=finance_control
DB_USER=finance
DB_PASSWORD=change_me_use_a_strong_password

# Clave para autenticar los endpoints /api/v1/* (header X-API-Key).
# Genera una fuerte, p. ej.: openssl rand -hex 24
API_KEY=change_me_generate_a_strong_api_key
